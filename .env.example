# 高德 Web 服务 Key（必填）
AMAP_API_KEY=

# 高德 Web端(JS API) Key（前端地图用，可选）
AMAP_JS_KEY=

# 高德 JS API 安全密钥 securityJsCode（与 JS Key 配套，可选）
AMAP_JS_SECURITY_CODE=

# DeepSeek API Key（必填）
DEEPSEEK_API_KEY=

# DeepSeek 模型（可选，默认 deepseek-v4-flash）
# DEEPSEEK_MODEL=deepseek-v4-flash

# Redis 缓存（可选，不配置则禁用缓存）
REDIS_URL=redis://localhost:6379/0

# HTTP 代理（可选）
# HTTPS_PROXY=http://127.0.0.1:7890
