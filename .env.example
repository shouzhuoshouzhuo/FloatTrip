# 高德 Web 服务 Key（必填）
AMAP_API_KEY=

# 高德 Web端(JS API) Key（前端地图用，可选）
AMAP_JS_KEY=

# 高德 JS API 安全密钥 securityJsCode（与 JS Key 配套，可选）
AMAP_JS_SECURITY_CODE=

# LLM 提供商（可选，默认 "deepseek"，支持 "deepseek"、"doubao"）
# LLM_PROVIDER=deepseek

# DeepSeek API Key（如果使用 DeepSeek 提供商，此项必填）
DEEPSEEK_API_KEY=

# DeepSeek 模型（可选，默认 deepseek-v4-flash）
# DEEPSEEK_MODEL=deepseek-v4-flash

# 豆包 API Key（如果使用豆包提供商，此项必填）
# DOUBAO_API_KEY=

# 豆包模型（可选，默认 doubao-pro-4k）
# DOUBAO_MODEL=doubao-pro-4k

# Redis 缓存（可选，不配置则禁用缓存）
REDIS_URL=redis://localhost:6379/0

# Agent Runtime 并发与 checkpoint（均可选，以下为默认值）
# RUNTIME_CHAT_CONCURRENCY=8
# RUNTIME_PLANNING_CONCURRENCY=2
# RUNTIME_PLANNING_PER_USER=2
# RUNTIME_LLM_CONCURRENCY=8
# RUNTIME_AMAP_CONCURRENCY=8
# RUNTIME_CHECKPOINT_DB=data/langgraph-checkpoints.db

# HTTP 代理（可选）
# HTTPS_PROXY=http://127.0.0.1:7890

# LangSmith 追踪（可选，接入后可在 smith.langchain.com 查看 Agent 链路）
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__你的key
# LANGCHAIN_PROJECT=floattrip-dev
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
